# Copie para /etc/conectorcaixa.env na VPS (fora do repositório) e preencha.
#   sudo cp docs/vps/env.exemplo /etc/conectorcaixa.env && sudo chmod 600 /etc/conectorcaixa.env
# NUNCA coloque a chave secreta no Git.

# Banco (Supabase novo) — Project Settings → API
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# SECRETA — só no servidor
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# IA própria (depois de trocar o @lovable.dev/ai-gateway pelo SDK da Anthropic)
ANTHROPIC_API_KEY="sk-ant-..."

# Porta do app (o nginx encaminha para ela)
PORT=3000
